    No cleartext anywhere. The app fetches from one fixed host, over https: the Macaulay Library's
    image host, for a bird's photograph (BirdPhoto.kt). The BirdNET models are in the APK.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
