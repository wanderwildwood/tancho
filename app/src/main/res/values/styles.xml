<resources>
    <!-- The panel is grey, so the app is black and white and nothing else. Colour on
         e-ink is a set of greys the reader has to decode; anything that matters here is
         said with weight, size or a filled shape instead. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light">
        <item name="colorPrimary">@android:color/black</item>
        <item name="colorPrimaryDark">@android:color/black</item>
        <item name="colorAccent">@android:color/black</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@android:color/black</item>
        <item name="colorSecondary">@android:color/black</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorSurfaceVariant">@android:color/white</item>
        <item name="popupMenuBackground">@android:color/white</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="toolbarStyle">@style/Widget.MaterialComponents.Toolbar.Primary</item>
    </style>

    <!-- One destination in the navigation row. Matches the listening screen's own row:
         a word, centred, with room around it big enough to hit without looking. -->
    <style name="Destination">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- The listening screen draws its own bar with MMD. -->
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
