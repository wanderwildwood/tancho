<?xml version="1.0" encoding="utf-8"?>
<!-- Confidence is drawn with the weight of the border, because the panel cannot carry
     upstream's red-to-green scale. Dashed reads as provisional. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="15dp"/>
    <stroke android:color="@android:color/black" android:dashWidth="3dp" android:dashGap="3dp" android:width="2dp"/>
    <padding
        android:bottom="5dp"
        android:top="5dp"
        android:left="5dp"
        android:right="5dp"/>
</shape>
