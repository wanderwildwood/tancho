<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's navigation, in the same words the listening screen uses. Upstream put a bar of
  four icons here - a microphone, an eye, an A-Z, a cog - which on a grey panel is four
  guesses. The screen you are on is left out of its own row rather than drawn as a selected
  state, because a selected icon and an unselected one are the same shape.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/destinationRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?colorSurface">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?colorOnSurface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/destination_listening"
            style="@style/Destination"
            android:text="@string/destination_listening" />

        <TextView
            android:id="@+id/destination_heard"
            style="@style/Destination"
            android:text="@string/destination_observations" />

        <TextView
            android:id="@+id/destination_species"
            style="@style/Destination"
            android:text="@string/destination_species" />

        <TextView
            android:id="@+id/destination_settings"
            style="@style/Destination"
            android:text="@string/destination_settings" />

    </LinearLayout>

</LinearLayout>
