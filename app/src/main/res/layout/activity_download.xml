<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurfaceVariant"
    android:fitsSystemWindows="true"
    tools:context=".DownloadActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:foregroundGravity="top"
            android:focusableInTouchMode="true"
            android:focusable="true"
            android:src="@drawable/ic_launcher_monochrome" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:layout_weight="5">

            <!-- Shown only when a model in the APK is not the one this version was built
                 with (ModelFiles.kt); otherwise this screen goes straight on to listening. -->
            <LinearLayout
                android:id="@+id/model_damaged"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@drawable/oval_color_accent_thin"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="?colorPrimary"
                    android:textSize="22sp"
                    android:text="@string/model_damaged_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="16dp"
                    android:textColor="?colorPrimary"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:text="@string/model_damaged_text" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Privacy, Terms and Licences, readable even when the model is refused. -->
    <ImageButton
        android:id="@+id/about_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@null"
        android:src="@drawable/ic_info_24dp"
        android:contentDescription="@string/about"
        android:onClick="about" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/about_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>